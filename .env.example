# ==========================================
# APPLICATION
# ==========================================

APP_ENV=development
TIMEZONE=Asia/Jakarta
DEFAULT_CV_PATH=data/

# Optional portfolio PDF. If set (and the file exists), it is attached alongside
# the CV and mentioned generically in generated emails. The AI never reads its
# contents. Leave empty to disable.
DEFAULT_PORTFOLIO_PATH=

# ==========================================
# AI (Gemini)
# ==========================================

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.4

# ==========================================
# EMAIL (Gmail API + OAuth 2.0)
# ==========================================

EMAIL_PROVIDER=gmail

# From Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth Client of type "Desktop App" (not "Web application").
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# The Gmail account used to SEND applications (must match the account you
# authenticate with via `jobapply auth gmail`).
GMAIL_SENDER_EMAIL=

# Where the OAuth token is stored locally (never committed to Git).
GMAIL_TOKEN_FILE=data/auth/gmail_token.json

# Legacy/compatibility only: InstalledAppFlow runs its own local loopback
# server and does not actually rely on this value.
GMAIL_REDIRECT_URI=http://localhost

# Set true to skip actually sending email (recommended for testing)
EMAIL_DRY_RUN=false

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=sqlite:///data/jobapply.db

# ==========================================
# SCHEDULER
# ==========================================

DEFAULT_SCHEDULE_TIME=08:00

# ==========================================
# SAFETY
# ==========================================

MAX_EMAILS_PER_BATCH=20
